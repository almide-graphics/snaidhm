// TTF parser unit tests — pure logic tests (no font_data externs required)
//
// Tests expand_implied and contours_to_cubics with synthetic data.
// Full integration tests run via browser (font.ttf loaded by JS).

import self.ttf as ttf

// ── expand_implied ──

test "expand_implied: all on-curve stays unchanged" {
  let contour = [
    { x: 0, y: 0, on_curve: true },
    { x: 100, y: 0, on_curve: true },
    { x: 100, y: 100, on_curve: true },
  ]
  let result = ttf.expand_implied(contour)
  assert(list.len(result) == 3)
  assert(result[0].x == 0)
  assert(result[1].x == 100)
  assert(result[2].x == 100)
}

test "expand_implied: two off-curve inserts midpoint" {
  let contour = [
    { x: 0, y: 0, on_curve: true },
    { x: 50, y: 100, on_curve: false },
    { x: 100, y: 100, on_curve: false },
    { x: 150, y: 0, on_curve: true },
  ]
  let result = ttf.expand_implied(contour)
  // Between the two off-curve points, an implied on-curve at (75, 100) is inserted
  assert(list.len(result) == 5)
  assert(result[2].x == 75)
  assert(result[2].y == 100)
  assert(result[2].on_curve == true)
}

test "expand_implied: starts with off-curve rotates to on-curve" {
  let contour = [
    { x: 50, y: 100, on_curve: false },
    { x: 100, y: 0, on_curve: true },
    { x: 0, y: 0, on_curve: true },
  ]
  let result = ttf.expand_implied(contour)
  // Should rotate so first element is on-curve
  assert(result[0].on_curve == true)
}

// ── contours_to_cubics ──

test "contours_to_cubics: triangle (all on-curve) produces 3 line cubics" {
  let contours = [[
    { x: 0, y: 0, on_curve: true },
    { x: 100, y: 0, on_curve: true },
    { x: 50, y: 100, on_curve: true },
  ]]
  let cubics = ttf.contours_to_cubics(contours, 1.0, 0.0, 0.0)
  // 3 edges of triangle → 3 cubics (line segments as degenerate cubics)
  assert(list.len(cubics) == 3)
  // First cubic: (0,0) → (100,0)
  assert(float.abs(cubics[0].ax - 0.0) < 0.01)
  assert(float.abs(cubics[0].ay - 0.0) < 0.01)
  assert(float.abs(cubics[0].dx - 100.0) < 0.01)
  assert(float.abs(cubics[0].dy - 0.0) < 0.01)
}

test "contours_to_cubics: quadratic bezier produces cubic" {
  let contours = [[
    { x: 0, y: 0, on_curve: true },
    { x: 50, y: 100, on_curve: false },
    { x: 100, y: 0, on_curve: true },
  ]]
  let cubics = ttf.contours_to_cubics(contours, 1.0, 0.0, 0.0)
  // quad (0,0)→ctrl(50,100)→(100,0) → 1 cubic + 1 closing line
  assert(list.len(cubics) == 2)
  // First cubic: start at (0,0), end at (100,0)
  assert(float.abs(cubics[0].ax - 0.0) < 0.01)
  assert(float.abs(cubics[0].dx - 100.0) < 0.01)
  // Control points: CP1 = (0,0) + 2/3*(50-0, 100-0) = (33.3, 66.7)
  assert(float.abs(cubics[0].bx - 33.333) < 0.1)
  assert(float.abs(cubics[0].by - 66.667) < 0.1)
  // CP2 = (100,0) + 2/3*(50-100, 100-0) = (66.7, 66.7)
  assert(float.abs(cubics[0].cx - 66.667) < 0.1)
  assert(float.abs(cubics[0].cy - 66.667) < 0.1)
}

test "contours_to_cubics: scale and offset applied" {
  let contours = [[
    { x: 0, y: 0, on_curve: true },
    { x: 100, y: 0, on_curve: true },
  ]]
  let cubics = ttf.contours_to_cubics(contours, 0.5, 10.0, 20.0)
  // (0*0.5+10, 0*0.5+20) → (100*0.5+10, 0*0.5+20) = (10,20) → (60,20)
  assert(list.len(cubics) == 2)  // 2 edges (it's a closed path)
  assert(float.abs(cubics[0].ax - 10.0) < 0.01)
  assert(float.abs(cubics[0].ay - 20.0) < 0.01)
  assert(float.abs(cubics[0].dx - 60.0) < 0.01)
  assert(float.abs(cubics[0].dy - 20.0) < 0.01)
}

test "contours_to_cubics: empty contour produces nothing" {
  let contours: List[List[ttf.GlyphPoint]] = [[]]
  let cubics = ttf.contours_to_cubics(contours, 1.0, 0.0, 0.0)
  assert(list.len(cubics) == 0)
}

test "contours_to_cubics: multiple contours" {
  let contours = [
    [{ x: 0, y: 0, on_curve: true }, { x: 10, y: 0, on_curve: true }, { x: 10, y: 10, on_curve: true }],
    [{ x: 2, y: 2, on_curve: true }, { x: 8, y: 2, on_curve: true }, { x: 5, y: 8, on_curve: true }],
  ]
  let cubics = ttf.contours_to_cubics(contours, 1.0, 0.0, 0.0)
  // 3 edges per triangle × 2 contours = 6 cubics
  assert(list.len(cubics) == 6)
}
