// snaidhm native font loading — @extern(rust) declarations
//
// The TTF parser (snaidhm.ttf) reads the font through the `font_data` host
// namespace. In the browser the page hands it the font's bytes; natively the
// program loads them from a file here, before building any text. Native only.

/// Load the TrueType font (glyf outlines — not CFF) at `path` as the font text
/// is built from. `false` when the file cannot be read; the reason is on
/// stderr, and any font loaded before stays.
@extern(rust, "crate::font_data", "load")
fn load(path: String) -> Bool = _
