// snaidhm native window — @extern(rust) declarations
//
// The on-screen counterpart of the browser canvas. In the browser the page
// owns the canvas and the frame loop; natively the program opens a window and
// runs the loop itself:
//
//   if window.open("demo", 800, 600) then {
//     var scene = build(window.width(), window.height())
//     while window.pump() {
//       if window.resized() then { scene = build(window.width(), window.height()) }
//       snaidhm.draw_frame(scene, 0.0)
//     }
//   }
//
// Native only: there is no @extern(wasm) half, so a wasm build must not
// import this module.

/// Open the window, `width` x `height` in logical pixels, and make it the
/// screen every later gpu render pass draws into. Call it before any gpu.*
/// call — the GPU device is chosen for its ability to present to this window.
/// `false` when no window can be opened; the reason is on stderr.
@extern(rust, "crate::window", "open")
fn open(title: String, width: Int, height: Int) -> Bool = _

// ── Windows ───────────────────────────────────────────────────────────────
//
// `open` opens window 1; more open with `open_window`. Every call about "the
// window" — its size, title, focus, IME, pointer, full screen — is about the
// one `select` chose, and render passes draw into it; inputs say which window
// they happened in (`event_window`).

/// Open another window, `width` x `height` logical pixels, a little below and
/// right of the current one; its id, 0 when it can't be opened. Needs a
/// window `open`ed first. It shows with its first frame.
@extern(rust, "crate::window", "open_window")
fn open_window(title: String, width: Int, height: Int) -> Int = _

/// Close window `id`.
@extern(rust, "crate::window", "close_window")
fn close_window(id: Int) -> Unit = _

/// Make window `id` the one the per-window calls are about and render passes
/// draw into.
@extern(rust, "crate::window", "select")
fn select(id: Int) -> Unit = _

/// The window `select` chose (1 until another is).
@extern(rust, "crate::window", "current")
fn current() -> Int = _

/// Where the window is: the top left of its frame, in logical pixels from
/// the top left of the main display. (0, 0) where the platform doesn't say.
@extern(rust, "crate::window", "x")
fn x() -> Float = _

@extern(rust, "crate::window", "y")
fn y() -> Float = _

/// Move the window's frame to (`x`, `y`) as `x` and `y` give it — unless
/// nothing of it would show on a display.
@extern(rust, "crate::window", "set_position")
fn set_position(x: Float, y: Float) -> Unit = _

/// Size the window's drawable area to `width` x `height` logical pixels.
@extern(rust, "crate::window", "set_size")
fn set_size(width: Float, height: Float) -> Unit = _

/// The window the current input happened in.
@extern(rust, "crate::window", "event_window")
fn event_window() -> Int = _

/// The window with the keyboard focus, 0 when none has it.
@extern(rust, "crate::window", "focused_window")
fn focused_window() -> Int = _

/// End the frame (show what its render passes drew) and process pending events
/// without waiting. `false` once the window has been asked to close.
@extern(rust, "crate::window", "pump")
fn pump() -> Bool = _

/// `pump`, but sleep until at least one event arrives. For a UI that only
/// changes in response to input: an idle window costs no CPU.
@extern(rust, "crate::window", "wait")
fn wait() -> Bool = _

/// `wait`, but also waking when one of `fds` has something to read, and after
/// at most `timeout_ms` (negative: no limit). For a program that waits on
/// files too — a terminal on its PTYs — without polling them.
@extern(rust, "crate::window", "wait_fds")
fn wait_fds(fds: List[Int], timeout_ms: Int) -> Bool = _

/// `true` exactly once after each change of the window's size — the moment to
/// rebuild anything sized to it.
@extern(rust, "crate::window", "resized")
fn resized() -> Bool = _

/// Width of the drawable area in physical pixels, the size render targets are.
@extern(rust, "crate::window", "width")
fn width() -> Int = _

/// Height of the drawable area in physical pixels.
@extern(rust, "crate::window", "height")
fn height() -> Int = _

/// Physical pixels per logical pixel (2.0 on a typical Retina display).
@extern(rust, "crate::window", "scale_factor")
fn scale_factor() -> Float = _

// ── Input ─────────────────────────────────────────────────────────────────
//
// Window input, queued in logical pixels and read one event at a time. Kinds
// and key codes follow the DOM, so browser and native hosts hand a UI the
// same events.

let NONE = 0
let MOUSE_MOVE = 1
let MOUSE_DOWN = 2
let MOUSE_UP = 3
let WHEEL = 4
/// A typed character; `event_code` is its code point.
let TEXT = 5
/// A key handled as a key; `event_code` is its DOM keyCode.
let KEY = 6
/// What the input method is composing (after `set_ime(true)`): `event_text`
/// is the whole composition, empty once it ends, and `event_code` ..
/// `event_end` the part it marks — the clause being converted, or an empty
/// range at its caret — in characters, -1 when it shows no caret. What it
/// commits arrives as TEXT events.
let COMPOSE = 7
/// A file was dropped on the window, at the pointer: `event_text` is its
/// path. Several dropped at once come as several DROPs in a row.
let DROP = 8
/// The system's appearance changed between light and dark: see `dark`.
let THEME = 9
/// The window gained (`event_code` 1) or lost (0) the keyboard focus.
let FOCUS = 10
/// A window's close button, while more than one is open; with one, `pump`
/// and the waits return `false` instead.
let CLOSE = 11

let KEY_BACKSPACE = 8
let KEY_TAB = 9
let KEY_ENTER = 13
let KEY_ESCAPE = 27
let KEY_LEFT = 37
let KEY_UP = 38
let KEY_RIGHT = 39
let KEY_DOWN = 40
let KEY_DELETE = 46
let KEY_PAGE_UP = 33
let KEY_PAGE_DOWN = 34
let KEY_END = 35
let KEY_HOME = 36
let KEY_INSERT = 45
/// F1 .. F12 are KEY_F1 .. KEY_F1 + 11.
let KEY_F1 = 112

/// Modifier bits of `event_mods`.
let MOD_SHIFT = 1
let MOD_CTRL = 2
let MOD_ALT = 4
let MOD_SUPER = 8

/// The kind of the next queued input (NONE once the queue is empty); the
/// `event_*` accessors then describe it. Inputs queue across `pump` calls.
@extern(rust, "crate::window", "next_event")
fn next_event() -> Int = _

/// Pointer position of the current input, logical pixels.
@extern(rust, "crate::window", "event_x")
fn event_x() -> Float = _

@extern(rust, "crate::window", "event_y")
fn event_y() -> Float = _

/// Wheel distance of the current input, logical pixels; positive `dy`
/// scrolls down, as the DOM's `deltaY`.
@extern(rust, "crate::window", "event_dx")
fn event_dx() -> Float = _

@extern(rust, "crate::window", "event_dy")
fn event_dy() -> Float = _

/// Mouse button (0 left, 1 right, 2 middle), typed code point, or key code.
@extern(rust, "crate::window", "event_code")
fn event_code() -> Int = _

/// End of the marked part of the current COMPOSE, characters.
@extern(rust, "crate::window", "event_end")
fn event_end() -> Int = _

/// Modifiers held when the current input happened (MOD_* bits). With Ctrl,
/// Alt or Super held, a TEXT input carries the key's own character — `c` for
/// Ctrl+C — rather than what the platform would type.
@extern(rust, "crate::window", "event_mods")
fn event_mods() -> Int = _

/// Text of the current COMPOSE, or the path of the current DROP.
@extern(rust, "crate::window", "event_text")
fn event_text() -> String = _

// ── Input method ──────────────────────────────────────────────────────────

/// Let the platform's input method compose text in the window — Japanese,
/// Chinese, Korean — or (`false`, the default) take keys as they are.
@extern(rust, "crate::window", "set_ime")
fn set_ime(allowed: Bool) -> Unit = _

/// Take back a close the user asked for — the window's close button — after
/// `pump` or a wait returned false for it: for a program that asks first
/// ("a program is still running; close?") and heard no.
@extern(rust, "crate::window", "keep_open")
fn keep_open() -> Unit = _

/// Minimize the window to the Dock.
@extern(rust, "crate::window", "minimize")
fn minimize() -> Unit = _

/// Set the window's title.
@extern(rust, "crate::window", "set_title")
fn set_title(title: String) -> Unit = _

/// Ask for the user's attention while the window is in the background (the
/// Dock icon bounces once on macOS; the window is marked urgent elsewhere).
@extern(rust, "crate::window", "request_attention")
fn request_attention() -> Unit = _

/// The pointer's shape over the window: 0 the arrow, 1 the text I-beam, 2
/// the hand of a link.
@extern(rust, "crate::window", "set_pointer")
fn set_pointer(kind: Int) -> Unit = _

let POINTER_ARROW = 0
let POINTER_TEXT = 1
let POINTER_LINK = 2

/// Make the window full screen (a space of its own on macOS), or back.
@extern(rust, "crate::window", "toggle_fullscreen")
fn toggle_fullscreen() -> Unit = _

/// Which Option keys type as Alt (ESC before the key) rather than
/// composing characters: 0 neither, 1 both, 2 the left, 3 the right. macOS
/// only; elsewhere Alt is always Alt.
@extern(rust, "crate::window", "set_option_as_alt")
fn set_option_as_alt(mode: Int) -> Unit = _

/// Whether the window has the keyboard focus; FOCUS events follow changes.
@extern(rust, "crate::window", "focused")
fn focused() -> Bool = _

/// Whether the system shows its dark appearance; THEME events follow changes.
@extern(rust, "crate::window", "dark")
fn dark() -> Bool = _

/// Fill what a frame doesn't cover with this colour (0..1 each): the edge a
/// window being resized uncovers before the program draws for its new size.
/// macOS only.
@extern(rust, "crate::window", "set_background")
fn set_background(r: Float, g: Float, b: Float) -> Unit = _

/// Tell the input method where the caret is, logical pixels, so its
/// candidate window opens beside it. Call it whenever the caret moves.
@extern(rust, "crate::window", "set_ime_area")
fn set_ime_area(x: Float, y: Float, w: Float, h: Float) -> Unit = _
