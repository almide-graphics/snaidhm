// snaidhm — Compute-shader 2D path renderer (library API)
//
// Public types, shape/paint/shadow constructors, and render_scene().
// Consumers (ceangal, standalone demo) import this module.

import fs
import self.web.gpu as gpu
import self.sfnt as sfnt
import self.coarse as coarse
import self.text as text
import math

let TILE = 16
let DISPATCH_TILE = 64
let MAX_ITEMS_PER_TILE = 32

// ── Types ──

type Vec2 = { x: Float, y: Float }
type Cubic = { a: Vec2, b: Vec2, c: Vec2, d: Vec2, color: List[Float], path_id: Int }
type Seg = { p0: Vec2, p1: Vec2, color: List[Float], path_id: Int }
type Shadow = { cx: Float, cy: Float, hw: Float, hh: Float, cr: Float, ox: Float, oy: Float, blur: Float, color: List[Float] }
type Paint = { kind: Int, c0: List[Float], c1: List[Float], params: List[Float] }
type TextSpec = { chars: List[Int], size: Float, x: Float, y: Float, align: Int, color: List[Float] }

let ALIGN_LEFT = 0
let ALIGN_CENTER = 1

// ── Bezier math ──

fn cubic_eval(a: Vec2, b: Vec2, c: Vec2, d: Vec2, t: Float) -> Vec2 = {
  let u = 1.0 - t
  let uu = u * u
  let tt = t * t
  { x: uu*u*a.x + 3.0*uu*t*b.x + 3.0*u*tt*c.x + tt*t*d.x,
    y: uu*u*a.y + 3.0*uu*t*b.y + 3.0*u*tt*c.y + tt*t*d.y }
}

// Flattening tolerance in normal space: half a pixel at up to a 1024px viewport.
let FLATTEN_TOL = 0.5 / 1024.0

fn wang_n(a: Vec2, b: Vec2, c: Vec2, d: Vec2) -> Int = {
  let d1x = c.x - 2.0*b.x + a.x
  let d1y = c.y - 2.0*b.y + a.y
  let d2x = d.x - 2.0*c.x + b.x
  let d2y = d.y - 2.0*c.y + b.y
  let dd = float.max(math.sqrt(d1x*d1x + d1y*d1y), math.sqrt(d2x*d2x + d2y*d2y))
  int.max(1, int.min(256, float.to_int(float.ceil(math.sqrt(3.0 * dd / (4.0 * FLATTEN_TOL))))))
}

// Whether `p` lies on the chord a→d, within tolerance and between its ends.
fn on_chord(p: Vec2, a: Vec2, d: Vec2) -> Bool = {
  let dx = d.x - a.x
  let dy = d.y - a.y
  let len2 = dx * dx + dy * dy
  let px = p.x - a.x
  let py = p.y - a.y
  if len2 < FLATTEN_TOL * FLATTEN_TOL then px * px + py * py <= FLATTEN_TOL * FLATTEN_TOL
  else {
    let t = (px * dx + py * dy) / len2
    let cross = px * dy - py * dx
    t >= 0.0 and t <= 1.0 and cross * cross <= FLATTEN_TOL * FLATTEN_TOL * len2
  }
}

// A cubic whose control points lie on its chord is a straight line, and
// flattens to exactly one segment. Wang's bound measures how unevenly the
// curve is parametrised, not how it bends: an edge written with its control
// points on its endpoints (round_rect_cubics does) has a large second
// difference and would be cut into ~50 collinear pieces — enough to overflow
// the per-tile segment budget and silently drop the rest of the path.
fn segment_count(a: Vec2, b: Vec2, c: Vec2, d: Vec2) -> Int =
  if on_chord(b, a, d) and on_chord(c, a, d) then 1 else wang_n(a, b, c, d)

fn flatten_cubic(a: Vec2, b: Vec2, c: Vec2, d: Vec2, color: List[Float], pid: Int) -> List[Seg] = {
  let n = segment_count(a, b, c, d)
  let nf = int.to_float(n)
  0..<n |> list.map((i) => {
    let t0 = int.to_float(i) / nf
    let t1 = int.to_float(i + 1) / nf
    { p0: cubic_eval(a, b, c, d, t0), p1: cubic_eval(a, b, c, d, t1), color: color, path_id: pid }
  })
}

// ── DDA tile walk ──
// Returns list of encoded ints: tile_id * 2 + (1 if top_edge else 0)
// Segment is normalized to walk downward (sy0 ≤ sy1) internally.
// DDA tile walk (unused in current all-columns-left pipeline, kept for future DDA)
fn dda_tiles(p0: Vec2, p1: Vec2) -> List[Int] = {
  let tile_scale = 1.0 / int.to_float(TILE)
  let w_f = 512.0  // DDA uses fixed reference (not used in render path)
  let h_f = 512.0
  let tiles_x = 512 / TILE
  let tiles_y = 512 / TILE
  let px0 = (p0.x + 1.0) * 0.5 * w_f
  let py0 = (1.0 - p0.y) * 0.5 * h_f
  let px1 = (p1.x + 1.0) * 0.5 * w_f
  let py1 = (1.0 - p1.y) * 0.5 * h_f
  let is_down = py1 >= py0
  let sx0 = (if is_down then px0 else px1) * tile_scale
  let sy0 = (if is_down then py0 else py1) * tile_scale
  let sx1 = (if is_down then px1 else px0) * tile_scale
  let sy1 = (if is_down then py1 else py0) * tile_scale
  let dx = float.abs(sx1 - sx0)
  let dy = sy1 - sy0
  if dx + dy < 0.000001 then [] else {
  if dy < 0.000001 and float.abs(sy0 - float.floor(sy0)) < 0.000001 then [] else {
  let idxdy = 1.0 / (dx + dy)
  let a_raw = dx * idxdy
  let is_pos = sx1 >= sx0
  let sign = if is_pos then 1.0 else -1.0
  let xt0 = float.floor(sx0 * sign)
  let c = sx0 * sign - xt0
  let y0 = float.floor(sy0)
  let ytop = if dy < 0.000001 then float.ceil(sy0) else y0 + 1.0
  let b = float.min((dy * c + dx * (ytop - sy0)) * idxdy, 0.99999994)
  let span_x = float.max(1.0, float.ceil(float.max(sx0, sx1)) - float.floor(float.min(sx0, sx1)))
  let span_y = float.max(1.0, float.ceil(sy1) - float.floor(sy0))
  let count_x = float.to_int(span_x) - 1
  let count = count_x + float.to_int(span_y)
  let robust_err = float.floor(a_raw * int.to_float(count - 1) + b) - int.to_float(count_x)
  let a = if robust_err > 0.0 then a_raw - 0.0000002
          else if robust_err < 0.0 then a_raw + 0.0000002
          else a_raw
  let x0 = xt0 * sign + (if is_pos then 0.0 else -1.0)
  var last_z = float.floor(b - a)
  var result: List[Int] = []
  for i in 0..<count {
    let zf = a * int.to_float(i) + b
    let z = float.floor(zf)
    let ty = float.to_int(y0 + int.to_float(i) - z)
    let tx = float.to_int(x0 + sign * z)
    if tx >= 0 and tx < tiles_x and ty >= 0 and ty < tiles_y then {
      let top_edge = if i == 0 then float.floor(sy0) == sy0 else last_z == z
      let tid = ty * tiles_x + tx
      result = result + [tid * 2 + (if top_edge then 1 else 0)]
    } else ()
    last_z = z
  }
  result
  }
  }
}

// ── Shape builders ──

fn circle_cubics(cx: Float, cy: Float, r: Float, c: List[Float], pid: Int) -> List[Cubic] = {
  let k = 0.5522847498 * r
  [
    { a: {x:cx,y:cy+r}, b: {x:cx+k,y:cy+r}, c: {x:cx+r,y:cy+k}, d: {x:cx+r,y:cy}, color:c, path_id:pid },
    { a: {x:cx+r,y:cy}, b: {x:cx+r,y:cy-k}, c: {x:cx+k,y:cy-r}, d: {x:cx,y:cy-r}, color:c, path_id:pid },
    { a: {x:cx,y:cy-r}, b: {x:cx-k,y:cy-r}, c: {x:cx-r,y:cy-k}, d: {x:cx-r,y:cy}, color:c, path_id:pid },
    { a: {x:cx-r,y:cy}, b: {x:cx-r,y:cy+k}, c: {x:cx-k,y:cy+r}, d: {x:cx,y:cy+r}, color:c, path_id:pid },
  ]
}

fn round_rect_cubics(x: Float, y: Float, w: Float, h: Float, r: Float, c: List[Float], pid: Int) -> List[Cubic] = {
  let k = 0.5522847498 * r
  [
    { a: {x:x+r,y:y+h}, b: {x:x+r,y:y+h}, c: {x:x+w-r,y:y+h}, d: {x:x+w-r,y:y+h}, color:c, path_id:pid },
    { a: {x:x+w-r,y:y+h}, b: {x:x+w-r+k,y:y+h}, c: {x:x+w,y:y+h-r+k}, d: {x:x+w,y:y+h-r}, color:c, path_id:pid },
    { a: {x:x+w,y:y+h-r}, b: {x:x+w,y:y+h-r}, c: {x:x+w,y:y+r}, d: {x:x+w,y:y+r}, color:c, path_id:pid },
    { a: {x:x+w,y:y+r}, b: {x:x+w,y:y+r-k}, c: {x:x+w-r+k,y:y}, d: {x:x+w-r,y:y}, color:c, path_id:pid },
    { a: {x:x+w-r,y:y}, b: {x:x+w-r,y:y}, c: {x:x+r,y:y}, d: {x:x+r,y:y}, color:c, path_id:pid },
    { a: {x:x+r,y:y}, b: {x:x+r-k,y:y}, c: {x:x,y:y+r-k}, d: {x:x,y:y+r}, color:c, path_id:pid },
    { a: {x:x,y:y+r}, b: {x:x,y:y+r}, c: {x:x,y:y+h-r}, d: {x:x,y:y+h-r}, color:c, path_id:pid },
    { a: {x:x,y:y+h-r}, b: {x:x,y:y+h-r+k}, c: {x:x+r-k,y:y+h}, d: {x:x+r,y:y+h}, color:c, path_id:pid },
  ]
}

// ── Paint constructors ──

fn solid(r: Float, g: Float, b: Float, a: Float) -> Paint =
  { kind: 0, c0: [r,g,b,a], c1: [0.0,0.0,0.0,0.0], params: [0.0,0.0,0.0,0.0] }

fn linear_grad(c0: List[Float], c1: List[Float], sx: Float, sy: Float, ex: Float, ey: Float) -> Paint =
  { kind: 1, c0: c0, c1: c1, params: [sx, sy, ex, ey] }

fn radial_grad(c0: List[Float], c1: List[Float], cx: Float, cy: Float, radius: Float) -> Paint =
  { kind: 2, c0: c0, c1: c1, params: [cx, cy, radius, 0.0] }

// ── Shadow constructors ──

fn rect_shadow(x: Float, y: Float, w: Float, h: Float, r: Float, ox: Float, oy: Float, blur: Float, col: List[Float]) -> Shadow =
  { cx: x+w/2.0, cy: y+h/2.0, hw: w/2.0, hh: h/2.0, cr: r, ox: ox, oy: oy, blur: blur, color: col }

fn circ_shadow(cx: Float, cy: Float, rad: Float, ox: Float, oy: Float, blur: Float, col: List[Float]) -> Shadow =
  { cx: cx, cy: cy, hw: rad, hh: rad, cr: rad, ox: ox, oy: oy, blur: blur, color: col }

// ── Text helpers ──

fn str(s: String) -> List[Int] = string.to_bytes(s)

fn text_spec(chars: List[Int], size: Float, x: Float, y: Float, align: Int, color: List[Float]) -> TextSpec =
  { chars: chars, size: size, x: x, y: y, align: align, color: color }

fn measure_text(font: sfnt.Font, chars: List[Int], size: Float, viewport_h: Float) -> Float = {
  let scale = size * 2.0 / viewport_h / int.to_float(font.units_per_em)
  var w = 0.0
  let n = list.len(chars)
  for i in 0..<n { w = w + int.to_float(sfnt.advance(font, sfnt.glyph_id(font, chars[i]))) * scale }
  w
}

// ── Upload helpers (internal) ──

fn upload_shadows(device: Int, shadows: List[Shadow]) -> Int = {
  // At least one element: a zero-sized storage binding is a validation error,
  // and a scene without shadows is ordinary.
  let buf = gpu.create_buffer(device, int.max(1, list.len(shadows)) * 48, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for s in shadows {
    gpu.push_f32(s.cx) gpu.push_f32(s.cy) gpu.push_f32(s.hw) gpu.push_f32(s.hh)
    gpu.push_f32(s.cr) gpu.push_f32(s.ox) gpu.push_f32(s.oy) gpu.push_f32(s.blur)
    gpu.push_f32(s.color[0]) gpu.push_f32(s.color[1]) gpu.push_f32(s.color[2]) gpu.push_f32(s.color[3])
  }
  gpu.flush_to_buffer(device, buf)
  buf
}

fn upload_paints(device: Int, paints: List[Paint]) -> Int = {
  let buf = gpu.create_buffer(device, int.max(1, list.len(paints)) * 64, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for p in paints {
    gpu.push_u32(p.kind) gpu.push_u32(0) gpu.push_u32(0) gpu.push_u32(0)
    gpu.push_f32(p.c0[0]) gpu.push_f32(p.c0[1]) gpu.push_f32(p.c0[2]) gpu.push_f32(p.c0[3])
    gpu.push_f32(p.c1[0]) gpu.push_f32(p.c1[1]) gpu.push_f32(p.c1[2]) gpu.push_f32(p.c1[3])
    gpu.push_f32(p.params[0]) gpu.push_f32(p.params[1]) gpu.push_f32(p.params[2]) gpu.push_f32(p.params[3])
  }
  gpu.flush_to_buffer(device, buf)
  buf
}

// ── Scene handle (GPU resources cached across frames) ──

type SceneHandle = {
  device: Int,
  width: Int,
  height: Int,
  viewport_tiles_x: Int,
  viewport_tiles_y: Int,
  content_tiles_x: Int,
  content_tiles_y: Int,
  dispatch_tiles_x: Int,
  dispatch_tiles_y: Int,
  params_buf: Int,
  regions_buf: Int,
  pixel_buf: Int,
  items_buf: Int,
  tile_counts_buf: Int,
  tile_ids_buf: Int,
  compute_pipeline: Int,
  compute_bg: Int,
  compute_regions_bg: Int,
  compute_tile_bg: Int,
  quad_pipeline: Int,
  quad_bg: Int,
  quad_regions_bg: Int,
  quad_bg_tex: Int,
  img_pipeline: Int,
  img_bg: Int,
  img_vtx: Int,
  img_idx: Int,
  img_count: Int,
  format: Int,
}

// ── Prepare: flatten + tile + upload + create pipelines (called once, or on resize) ──

fn prepare_scene(
  device: Int,
  width: Int,
  height: Int,
  content_width: Int,
  content_height: Int,
  cubics: List[Cubic],
  shadows: List[Shadow],
  paints: List[Paint],
  img_vtx: Int,
  img_idx: Int,
  img_count: Int,
  img_texture: Int,
  img_sampler: Int,
  bg_texture: Int,
  bg_sampler: Int,
) -> SceneHandle = {
  let format = gpu.get_preferred_format()
  let _ctx = gpu.configure_canvas(device, format)
  let content_tiles_x = content_width / TILE
  let content_tiles_y = content_height / TILE
  let viewport_tiles_x = width / TILE
  let viewport_tiles_y = height / TILE
  let num_tiles = content_tiles_x * content_tiles_y

  // ── Flatten ──
  var segments: List[Seg] = []
  for cub in cubics {
    segments = segments + flatten_cubic(cub.a, cub.b, cub.c, cub.d, cub.color, cub.path_id)
  }
  let num_paths = list.len(paints)

  // ── Coarse raster: packed per-tile command lists (see coarse.almd) ──
  // Lines go to pixel space for tiling and back to normal space for upload,
  // the space raster.wgsl reads them in.
  let w_f = int.to_float(width)
  let h_f = int.to_float(height)
  var path_lines: List[coarse.PathLine] = []
  for seg in segments {
    list.push(path_lines, {
      path: seg.path_id,
      x0: (seg.p0.x + 1.0) * 0.5 * w_f, y0: (1.0 - seg.p0.y) * 0.5 * h_f,
      x1: (seg.p1.x + 1.0) * 0.5 * w_f, y1: (1.0 - seg.p1.y) * 0.5 * h_f,
    })
  }
  let tiles = coarse.build(path_lines, TILE, content_tiles_x, content_tiles_y, num_paths)
  let seg_count = list.len(tiles.lines)

  // ── Upload buffers ──
  // Every buffer holds at least one element: a zero-sized storage binding is a
  // validation error, and an empty scene is ordinary.
  let seg_buf = gpu.create_buffer(device, int.max(1, seg_count) * 48, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for l in tiles.lines {
    gpu.push_f32(l.x0 / (0.5 * w_f) - 1.0) gpu.push_f32(1.0 - l.y0 / (0.5 * h_f))
    gpu.push_f32(l.x1 / (0.5 * w_f) - 1.0) gpu.push_f32(1.0 - l.y1 / (0.5 * h_f))
    for _ in 0..<8 { gpu.push_u32(0) }
  }
  if seg_count == 0 then { for _ in 0..<12 { gpu.push_u32(0) } } else ()
  gpu.flush_to_buffer(device, seg_buf)

  // Per tile: first command, command count.
  let tc_buf = gpu.create_buffer(device, int.max(1, num_tiles * 2) * 4, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for v in tiles.index { gpu.push_u32(v) }
  gpu.flush_to_buffer(device, tc_buf)

  let ts_buf = gpu.create_buffer(device, int.max(1, list.len(tiles.line_ids)) * 4, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for id in tiles.line_ids { gpu.push_u32(id) }
  gpu.flush_to_buffer(device, ts_buf)

  // Per command: path, backdrop (i32 bits), first slot in ts_buf, line count.
  let tcmd_buf = gpu.create_buffer(device, int.max(1, list.len(tiles.cmds)) * 4, int.bor(gpu.STORAGE, gpu.COPY_DST))
  gpu.begin_data()
  for v in tiles.cmds { gpu.push_u32(v) }
  gpu.flush_to_buffer(device, tcmd_buf)

  // Pixel buffer = viewport size (vlist: only visible items rendered at viewport coords)
  let pixel_buf = gpu.create_buffer(device, width * height * 4, gpu.STORAGE)

  let params_buf = gpu.create_buffer(device, 64, int.bor(gpu.UNIFORM, gpu.COPY_DST))
  gpu.begin_data()
  gpu.push_u32(width) gpu.push_u32(height) gpu.push_u32(seg_count)
  gpu.push_u32(content_tiles_x) gpu.push_u32(content_tiles_y) gpu.push_u32(list.len(shadows))
  gpu.push_u32(num_paths) gpu.push_f32(0.0)
  gpu.push_f32(0.0) gpu.push_f32(0.0) gpu.push_f32(0.0 - 1.0) gpu.push_f32(0.0)
  gpu.push_f32(0.0) gpu.push_f32(0.0) gpu.push_f32(0.0) gpu.push_f32(0.0)
  gpu.flush_to_buffer(device, params_buf)

  // Scroll regions buffer: 8 regions × 48 bytes = 384 bytes
  let regions_buf = gpu.create_buffer(device, 384, int.bor(gpu.STORAGE, gpu.COPY_DST))

  // Render items buffer: up to 256 items × 48 bytes = 12288 bytes
  let items_buf = gpu.create_buffer(device, 12288, int.bor(gpu.STORAGE, gpu.COPY_DST))

  // Tile dispatch buffers (item-to-tile assignment for compute shader)
  let dispatch_tiles_x = (width + DISPATCH_TILE - 1) / DISPATCH_TILE
  let dispatch_tiles_y = (height + DISPATCH_TILE - 1) / DISPATCH_TILE
  let tile_count = dispatch_tiles_x * dispatch_tiles_y
  let tile_counts_buf = gpu.create_buffer(device, int.max(1, tile_count * 4), int.bor(gpu.STORAGE, gpu.COPY_DST))
  let tile_ids_buf = gpu.create_buffer(device, int.max(1, tile_count * MAX_ITEMS_PER_TILE * 4), int.bor(gpu.STORAGE, gpu.COPY_DST))

  let shadow_buf = upload_shadows(device, shadows)
  let paint_buf = upload_paints(device, paints)

  // ── Pipelines + bind groups ──
  let compute_shader = gpu.create_shader(device, 0, 0)
  let quad_shader = gpu.create_shader(device, 1, 0)

  let compute_pipeline = gpu.create_compute_pipeline(device, compute_shader, 0)
  gpu.begin_bindings()
  gpu.add_buffer_binding(seg_buf) gpu.add_buffer_binding(tc_buf) gpu.add_buffer_binding(ts_buf)
  gpu.add_buffer_binding(pixel_buf) gpu.add_buffer_binding(params_buf)
  gpu.add_buffer_binding(shadow_buf) gpu.add_buffer_binding(paint_buf) gpu.add_buffer_binding(tcmd_buf)
  let compute_bg = gpu.create_bound_group(device, compute_pipeline, 0)

  // Group 1 for compute: render_items only (scroll_regions unused in compute entry point)
  gpu.begin_bindings()
  gpu.add_buffer_binding(items_buf)
  let compute_regions_bg = gpu.create_bound_group(device, compute_pipeline, 1)

  // Group 3 for compute: tile dispatch (item-to-tile assignment)
  gpu.begin_bindings()
  gpu.add_buffer_binding(tile_counts_buf)
  gpu.add_buffer_binding(tile_ids_buf)
  let compute_tile_bg = gpu.create_bound_group(device, compute_pipeline, 3)

  let quad_pipeline = gpu.create_render_pipeline(device, quad_shader, 0, 0, 0, 0, format)
  gpu.begin_bindings()
  gpu.add_buffer_binding(pixel_buf) gpu.add_buffer_binding(params_buf)
  let quad_bg = gpu.create_bound_group(device, quad_pipeline, 0)

  // Group 1 for render: render_items (binding 0) + scroll_regions (binding 1)
  gpu.begin_bindings()
  gpu.add_buffer_binding(items_buf)
  gpu.add_buffer_binding(regions_buf)
  let quad_regions_bg = gpu.create_bound_group(device, quad_pipeline, 1)

  // Group 2 for render: background texture + sampler
  gpu.begin_bindings()
  gpu.add_texture_binding(bg_texture)
  gpu.add_sampler_binding(bg_sampler)
  let quad_bg_tex = gpu.create_bound_group(device, quad_pipeline, 2)

  let img_shader = gpu.create_shader(device, 3, 0)
  let img_pipeline = gpu.create_image_pipeline(device, img_shader, format)
  gpu.begin_bindings()
  gpu.add_texture_binding(img_texture) gpu.add_sampler_binding(img_sampler)
  let img_bg = gpu.create_bound_group(device, img_pipeline, 0)

  {
    device: device, width: width, height: height,
    viewport_tiles_x: viewport_tiles_x, viewport_tiles_y: viewport_tiles_y,
    content_tiles_x: content_tiles_x, content_tiles_y: content_tiles_y,
    dispatch_tiles_x: dispatch_tiles_x, dispatch_tiles_y: dispatch_tiles_y,
    params_buf: params_buf, regions_buf: regions_buf, pixel_buf: pixel_buf,
    items_buf: items_buf, tile_counts_buf: tile_counts_buf, tile_ids_buf: tile_ids_buf,
    compute_pipeline: compute_pipeline, compute_bg: compute_bg,
    compute_regions_bg: compute_regions_bg, compute_tile_bg: compute_tile_bg,
    quad_pipeline: quad_pipeline, quad_bg: quad_bg, quad_regions_bg: quad_regions_bg, quad_bg_tex: quad_bg_tex,
    img_pipeline: img_pipeline, img_bg: img_bg,
    img_vtx: img_vtx, img_idx: img_idx, img_count: img_count,
    format: format,
  }
}

// ── Draw frame: update scroll_y + dispatch + present (called every frame, < 2ms) ──

fn draw_frame_2d(scene: SceneHandle, scroll_x: Float, scroll_y: Float,
                 bar_opacity_y: Float, bar_opacity_x: Float,
                 bar_hover_y: Float, bar_hover_x: Float) -> Unit =
  encode_frame(scene, scroll_x, scroll_y, bar_opacity_y, bar_opacity_x, bar_hover_y, bar_hover_x, 0, 0, 0, 0)

/// `draw_frame_2d`, then the text `layer` holds (see text.almd) over it.
fn draw_frame_2d_text(scene: SceneHandle, layer: text.TextLayer, scroll_x: Float, scroll_y: Float,
                      bar_opacity_y: Float, bar_opacity_x: Float,
                      bar_hover_y: Float, bar_hover_x: Float) -> Unit =
  encode_frame(scene, scroll_x, scroll_y, bar_opacity_y, bar_opacity_x, bar_hover_y, bar_hover_x,
    layer.pipeline, layer.bind_group, layer.vtx, layer.count)

fn encode_frame(scene: SceneHandle, scroll_x: Float, scroll_y: Float,
                bar_opacity_y: Float, bar_opacity_x: Float,
                bar_hover_y: Float, bar_hover_x: Float,
                text_pipeline: Int, text_bg: Int, text_vtx: Int, text_count: Int) -> Unit = {
  gpu.write_f32_at(scene.device, scene.params_buf, 28, scroll_y)
  gpu.write_f32_at(scene.device, scene.params_buf, 32, scroll_x)
  gpu.write_f32_at(scene.device, scene.params_buf, 36, bar_opacity_y)
  gpu.write_f32_at(scene.device, scene.params_buf, 40, bar_opacity_x)
  gpu.write_f32_at(scene.device, scene.params_buf, 48, bar_hover_y)
  gpu.write_f32_at(scene.device, scene.params_buf, 52, bar_hover_x)
  // vlist_item_h at offset 56, vlist_item_count at offset 60 — written by ceangal

  let encoder = gpu.begin_encoder(scene.device)

  let cp = gpu.begin_compute_pass(encoder)
  gpu.set_pipeline(cp, scene.compute_pipeline)
  gpu.set_bind_group(cp, 0, scene.compute_bg)
  gpu.set_bind_group(cp, 1, scene.compute_regions_bg)
  gpu.set_bind_group(cp, 3, scene.compute_tile_bg)
  gpu.dispatch_workgroups(cp, scene.viewport_tiles_x, scene.viewport_tiles_y, 1)
  gpu.end_pass(cp)

  let rp = gpu.begin_render_pass(encoder, 0.1, 0.1, 0.15, 1.0)
  gpu.set_pipeline(rp, scene.quad_pipeline)
  gpu.set_bind_group(rp, 0, scene.quad_bg)
  gpu.set_bind_group(rp, 1, scene.quad_regions_bg)
  gpu.set_bind_group(rp, 2, scene.quad_bg_tex)
  gpu.draw(rp, 6)

  gpu.set_pipeline(rp, scene.img_pipeline)
  gpu.set_bind_group(rp, 0, scene.img_bg)
  gpu.set_vertex_buffer(rp, 0, scene.img_vtx)
  gpu.set_index_buffer(rp, scene.img_idx)
  gpu.draw_indexed(rp, scene.img_count)

  if text_count > 0 then {
    gpu.set_pipeline(rp, text_pipeline)
    gpu.set_bind_group(rp, 0, text_bg)
    gpu.set_vertex_buffer(rp, 0, text_vtx)
    gpu.draw(rp, text_count)
  } else ()

  gpu.end_pass(rp)
  gpu.finish_and_submit(scene.device, encoder)
}

// Upload region data: 12 floats per region (48 bytes), up to 8 regions
fn upload_regions(scene: SceneHandle, count: Int,
                  bounds_x: List[Float], bounds_y: List[Float], bounds_w: List[Float], bounds_h: List[Float],
                  scroll_x: List[Float], scroll_y: List[Float],
                  content_w: List[Float], content_h: List[Float],
                  parent: List[Int],
                  bar_opacity_y: List[Float], bar_opacity_x: List[Float]) -> Unit = {
  gpu.begin_data()
  for i in 0..<8 {
    if i < count then {
      gpu.push_f32(bounds_x[i]) gpu.push_f32(bounds_y[i]) gpu.push_f32(bounds_w[i]) gpu.push_f32(bounds_h[i])
      gpu.push_f32(scroll_x[i]) gpu.push_f32(scroll_y[i])
      gpu.push_f32(content_w[i]) gpu.push_f32(content_h[i])
      gpu.push_f32(int.to_float(parent[i])) gpu.push_f32(int.to_float(count))
      gpu.push_f32(bar_opacity_y[i]) gpu.push_f32(bar_opacity_x[i])
    } else {
      for _ in 0..<12 { gpu.push_f32(0.0) }
    }
  }
  gpu.flush_to_buffer(scene.device, scene.regions_buf)
}

// Upload render items: 12 floats per item (48 bytes)
// [x, y, w, h, bg_r, bg_g, bg_b, bg_a, rounded, opacity, kind_f, item_count_f]
fn upload_items(scene: SceneHandle, count: Int,
                xs: List[Float], ys: List[Float], ws: List[Float], hs: List[Float],
                bg_rs: List[Float], bg_gs: List[Float], bg_bs: List[Float], bg_as: List[Float],
                roundeds: List[Float], opacities: List[Float],
                scrollables: List[Float]) -> Unit = {
  gpu.begin_data()
  for i in 0..<int.min(count, 256) {
    gpu.push_f32(xs[i]) gpu.push_f32(ys[i]) gpu.push_f32(ws[i]) gpu.push_f32(hs[i])
    gpu.push_f32(bg_rs[i]) gpu.push_f32(bg_gs[i]) gpu.push_f32(bg_bs[i]) gpu.push_f32(bg_as[i])
    gpu.push_f32(roundeds[i]) gpu.push_f32(opacities[i]) gpu.push_f32(scrollables[i]) gpu.push_f32(int.to_float(count))
  }
  // Pad remaining slots with zeros
  for _ in count..<256 {
    for _ in 0..<12 { gpu.push_f32(0.0) }
  }
  gpu.flush_to_buffer(scene.device, scene.items_buf)
}

// Upload tile assignment (item-to-tile mapping for tile dispatch)
fn upload_tile_assignment(scene: SceneHandle,
                          tile_counts: List[Int], tile_ids: List[Int]) -> Unit = {
  gpu.begin_data()
  for c in tile_counts { gpu.push_u32(c) }
  gpu.flush_to_buffer(scene.device, scene.tile_counts_buf)
  gpu.begin_data()
  for id in tile_ids { gpu.push_u32(id) }
  gpu.flush_to_buffer(scene.device, scene.tile_ids_buf)
}

// Compute pass only — bake content into pixel buffer (no render)
fn draw_compute_only(scene: SceneHandle) -> Unit = {
  let encoder = gpu.begin_encoder(scene.device)
  let cp = gpu.begin_compute_pass(encoder)
  gpu.set_pipeline(cp, scene.compute_pipeline)
  gpu.set_bind_group(cp, 0, scene.compute_bg)
  gpu.set_bind_group(cp, 1, scene.compute_regions_bg)
  gpu.set_bind_group(cp, 3, scene.compute_tile_bg)
  gpu.dispatch_workgroups(cp, scene.viewport_tiles_x, scene.viewport_tiles_y, 1)
  gpu.end_pass(cp)
  gpu.finish_and_submit(scene.device, encoder)
}

// Render pass only (no compute) — for fragment-only effects like mouse light
fn draw_render_only(scene: SceneHandle) -> Unit = {
  let encoder = gpu.begin_encoder(scene.device)
  let rp = gpu.begin_render_pass(encoder, 0.1, 0.1, 0.15, 1.0)
  gpu.set_pipeline(rp, scene.quad_pipeline)
  gpu.set_bind_group(rp, 0, scene.quad_bg)
  gpu.set_bind_group(rp, 1, scene.quad_regions_bg)
  gpu.set_bind_group(rp, 2, scene.quad_bg_tex)
  gpu.draw(rp, 6)
  gpu.set_pipeline(rp, scene.img_pipeline)
  gpu.set_bind_group(rp, 0, scene.img_bg)
  gpu.set_vertex_buffer(rp, 0, scene.img_vtx)
  gpu.set_index_buffer(rp, scene.img_idx)
  gpu.draw_indexed(rp, scene.img_count)
  gpu.end_pass(rp)
  gpu.finish_and_submit(scene.device, encoder)
}

fn draw_frame(scene: SceneHandle, scroll_y: Float) -> Unit =
  draw_frame_2d(scene, 0.0, scroll_y, 0.0, 0.0, 0.0, 0.0)

// ── Legacy API: one-shot render (prepare + draw in one call) ──

fn render_scene(
  device: Int,
  width: Int,
  height: Int,
  cubics: List[Cubic],
  shadows: List[Shadow],
  paints: List[Paint],
  img_vtx: Int,
  img_idx: Int,
  img_count: Int,
  img_texture: Int,
  img_sampler: Int,
  scroll_y: Float,
) -> Unit = {
  let scene = prepare_scene(device, width, height, width, height, cubics, shadows, paints,
    img_vtx, img_idx, img_count, img_texture, img_sampler, img_texture, img_sampler)
  draw_frame(scene, scroll_y)
}

// ── Text as paths ──

/// Every glyph of `specs` as filled paths, in normal space for a viewport
/// `viewport_h` px tall. Each glyph is its own path (the winding rule is per
/// path) with its own paint.
fn build_text_cubics(font: sfnt.Font, specs: List[TextSpec], viewport_h: Float) -> { cubics: List[Cubic], paints: List[Paint] } = {
  var cubics: List[Cubic] = []
  var paints: List[Paint] = []
  var pid = 0
  let ns = list.len(specs)
  for si in 0..<ns {
    let spec = specs[si]
    let scale = spec.size * 2.0 / viewport_h / int.to_float(font.units_per_em)
    var pen = if spec.align == ALIGN_CENTER then spec.x - measure_text(font, spec.chars, spec.size, viewport_h) / 2.0
              else spec.x
    let nc = list.len(spec.chars)
    for ci in 0..<nc {
      let gid = sfnt.glyph_id(font, spec.chars[ci])
      let flat = sfnt.closed_cubics(sfnt.outline(font, gid), scale, pen, spec.y)
      let n = list.len(flat) / 8
      if n > 0 then {
        for k in 0..<n {
          let o = k * 8
          list.push(cubics, {
            a: {x: flat[o], y: flat[o + 1]}, b: {x: flat[o + 2], y: flat[o + 3]},
            c: {x: flat[o + 4], y: flat[o + 5]}, d: {x: flat[o + 6], y: flat[o + 7]},
            color: spec.color, path_id: pid,
          })
        }
        list.push(paints, solid(spec.color[0], spec.color[1], spec.color[2], spec.color[3]))
        pid = pid + 1
      } else ()
      pen = pen + int.to_float(sfnt.advance(font, gid)) * scale
    }
  }
  { cubics: cubics, paints: paints }
}

// ── Standalone demo entry point ──

/// The demo's font: a file the page hands over through WASI (host/wasi.js).
let DEMO_FONT = "/font.ttf"

@export(wasm, "render")
effect fn render(device: Int, img_vtx: Int, img_idx: Int, img_count: Int, img_texture: Int, img_sampler: Int) -> Unit = {
  let dc = [0.5, 0.5, 0.5, 1.0]

  let shape_cubics =
    round_rect_cubics(-0.9, -0.9, 1.8, 1.8, 0.08, dc, 0)
    + round_rect_cubics(-0.85, 0.55, 1.7, 0.3, 0.04, dc, 1)
    + circle_cubics(-0.5, 0.0, 0.18, dc, 2)
    + circle_cubics(0.0, 0.0, 0.18, dc, 3)
    + circle_cubics(0.5, 0.0, 0.18, dc, 4)
    + round_rect_cubics(-0.85, -0.85, 0.5, 0.55, 0.04, dc, 5)
    + round_rect_cubics(-0.3, -0.85, 0.5, 0.55, 0.04, dc, 6)
    + round_rect_cubics(0.25, -0.85, 0.6, 0.55, 0.04, dc, 7)

  let shadows = [
    rect_shadow(-0.9, -0.9, 1.8, 1.8, 0.08, 0.01, -0.02, 0.08, [0.0,0.0,0.0,0.2]),
    circ_shadow(-0.5, 0.0, 0.18, 0.008, -0.015, 0.04, [0.0,0.0,0.0,0.25]),
    circ_shadow(0.0, 0.0, 0.18, 0.008, -0.015, 0.04, [0.0,0.0,0.0,0.25]),
    circ_shadow(0.5, 0.0, 0.18, 0.008, -0.015, 0.04, [0.0,0.0,0.0,0.25]),
    rect_shadow(-0.85, -0.85, 0.5, 0.55, 0.04, 0.005, -0.01, 0.03, [0.0,0.0,0.0,0.15]),
    rect_shadow(-0.3, -0.85, 0.5, 0.55, 0.04, 0.005, -0.01, 0.03, [0.0,0.0,0.0,0.15]),
    rect_shadow(0.25, -0.85, 0.6, 0.55, 0.04, 0.005, -0.01, 0.03, [0.0,0.0,0.0,0.15]),
  ]

  let shape_paints = [
    solid(1.0, 1.0, 1.0, 1.0),
    linear_grad([0.12,0.22,0.58,1.0], [0.28,0.48,0.88,1.0], -0.85, 0.85, -0.85, 0.55),
    radial_grad([1.0,0.55,0.5,0.9], [0.82,0.18,0.12,0.9], -0.5, 0.0, 0.18),
    radial_grad([0.45,0.92,0.55,0.9], [0.12,0.62,0.22,0.9], 0.0, 0.0, 0.18),
    radial_grad([0.5,0.7,1.0,0.9], [0.15,0.35,0.82,0.9], 0.5, 0.0, 0.18),
    solid(0.95, 0.95, 0.98, 1.0),
    solid(0.95, 0.95, 0.98, 1.0),
    solid(0.95, 0.95, 0.98, 1.0),
  ]

  let text_specs: List[TextSpec] = [
    { chars: str("snaidhm"), size: 40.0, x: 0.0, y: 0.64, align: ALIGN_CENTER, color: [1.0,1.0,1.0,1.0] },
    { chars: str("Almide > WASM > WebGPU"), size: 13.0, x: 0.0, y: 0.57, align: ALIGN_CENTER, color: [0.8,0.85,1.0,0.9] },
    { chars: str("Red"), size: 13.0, x: -0.5, y: -0.02, align: ALIGN_CENTER, color: [1.0,1.0,1.0,1.0] },
    { chars: str("Green"), size: 13.0, x: 0.0, y: -0.02, align: ALIGN_CENTER, color: [1.0,1.0,1.0,1.0] },
    { chars: str("Blue"), size: 13.0, x: 0.5, y: -0.02, align: ALIGN_CENTER, color: [1.0,1.0,1.0,1.0] },
    { chars: str("Card A"), size: 11.0, x: -0.8, y: -0.4, align: ALIGN_LEFT, color: [0.3,0.3,0.4,1.0] },
    { chars: str("Card B"), size: 11.0, x: -0.25, y: -0.4, align: ALIGN_LEFT, color: [0.3,0.3,0.4,1.0] },
    { chars: str("Card C"), size: 11.0, x: 0.3, y: -0.4, align: ALIGN_LEFT, color: [0.3,0.3,0.4,1.0] },
    { chars: str("Shapes + Text"), size: 16.0, x: 0.0, y: -0.68, align: ALIGN_CENTER, color: [0.5,0.5,0.6,1.0] },
    { chars: str("all from Almide"), size: 16.0, x: 0.0, y: -0.78, align: ALIGN_CENTER, color: [0.5,0.5,0.6,1.0] },
  ]

  let font = sfnt.load(fs.read_bytes_raw(DEMO_FONT)!, 0)!
  let text = build_text_cubics(font, text_specs, 512.0)

  // Remap text path_ids to continue after shape paints
  let num_shape_paints = list.len(shape_paints)
  let text_cubics = text.cubics |> list.map((cub) => {
    { a: cub.a, b: cub.b, c: cub.c, d: cub.d,
      color: cub.color, path_id: cub.path_id + num_shape_paints }
  })

  let cubics = shape_cubics + text_cubics
  let paints = shape_paints + text.paints

  render_scene(device, 512, 512, cubics, shadows, paints,
    img_vtx, img_idx, img_count, img_texture, img_sampler, 0.0)
}
