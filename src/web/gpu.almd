// snaidhm WebGPU bindings — @extern(wasm) declarations
//
// All GPU objects are opaque integer handles.
// The JS runtime manages the handle table.

// ── Buffer usage flags ──
let COPY_SRC     = 0x0004
let COPY_DST     = 0x0008
let INDEX        = 0x0010
let VERTEX       = 0x0020
let UNIFORM      = 0x0040
let STORAGE      = 0x0080
let MAP_READ     = 0x0001

// ── Texture usage flags ──
let TEX_COPY_DST = 0x0002
let TEX_BINDING  = 0x0004
let TEX_RENDER   = 0x0010

// ── Shader stage flags ──
let STAGE_VERTEX   = 0x1
let STAGE_FRAGMENT = 0x2
let STAGE_COMPUTE  = 0x4

// ── Device / Context ──

@extern(wasm, "gpu", "configure_canvas")
@extern(rust, "crate::gpu", "configure_canvas")
fn configure_canvas(device: Int, format: Int) -> Int = _

@extern(wasm, "gpu", "get_preferred_format")
@extern(rust, "crate::gpu", "get_preferred_format")
fn get_preferred_format() -> Int = _

// ── Shader ──

@extern(wasm, "gpu", "create_shader")
@extern(rust, "crate::gpu", "create_shader")
fn create_shader(device: Int, code_ptr: Int, code_len: Int) -> Int = _

// ── Buffer ──

@extern(wasm, "gpu", "create_buffer")
@extern(rust, "crate::gpu", "create_buffer")
fn create_buffer(device: Int, size: Int, usage: Int) -> Int = _

/// A buffer rewritten every frame — a UI's vertices — written with
/// `flush_to_buffer` and bound like any other. Natively it is a ring of
/// copies written in place, with no staging; in the browser, a buffer.
@extern(wasm, "gpu", "create_stream_buffer")
@extern(rust, "crate::gpu", "create_stream_buffer")
fn create_stream_buffer(device: Int, size: Int, usage: Int) -> Int = _

/// Free `buffer` now rather than when the program ends — for a buffer that
/// was outgrown and replaced. Work already submitted with it still runs.
@extern(wasm, "gpu", "destroy_buffer")
@extern(rust, "crate::gpu", "destroy_buffer")
fn destroy_buffer(device: Int, buffer: Int) -> Unit = _

@extern(wasm, "gpu", "write_buffer")
@extern(rust, "crate::gpu", "write_buffer")
fn write_buffer(device: Int, buffer: Int, data_ptr: Int, data_len: Int) -> Unit = _

// ── Render pipeline ──

@extern(wasm, "gpu", "create_render_pipeline")
@extern(rust, "crate::gpu", "create_render_pipeline")
fn create_render_pipeline(device: Int, shader: Int, vs_ptr: Int, vs_len: Int, fs_ptr: Int, fs_len: Int, format: Int) -> Int = _

// ── Commands ──

@extern(wasm, "gpu", "begin_encoder")
@extern(rust, "crate::gpu", "begin_encoder")
fn begin_encoder(device: Int) -> Int = _

@extern(wasm, "gpu", "begin_render_pass")
@extern(rust, "crate::gpu", "begin_render_pass")
fn begin_render_pass(encoder: Int, r: Float, g: Float, b: Float, a: Float) -> Int = _

@extern(wasm, "gpu", "set_pipeline")
@extern(rust, "crate::gpu", "set_pipeline")
fn set_pipeline(pass: Int, pipeline: Int) -> Unit = _

@extern(wasm, "gpu", "draw")
@extern(rust, "crate::gpu", "draw")
fn draw(pass: Int, vertex_count: Int) -> Unit = _

@extern(wasm, "gpu", "end_pass")
@extern(rust, "crate::gpu", "end_pass")
fn end_pass(pass: Int) -> Unit = _

@extern(wasm, "gpu", "finish_and_submit")
@extern(rust, "crate::gpu", "finish_and_submit")
fn finish_and_submit(device: Int, encoder: Int) -> Unit = _

// ── Compute pipeline ──

@extern(wasm, "gpu", "create_compute_pipeline")
@extern(rust, "crate::gpu", "create_compute_pipeline")
fn create_compute_pipeline(device: Int, shader: Int, entry_id: Int) -> Int = _

// ── Bind group (explicit binding API) ──

@extern(wasm, "gpu", "begin_bindings")
@extern(rust, "crate::gpu", "begin_bindings")
fn begin_bindings() -> Unit = _

@extern(wasm, "gpu", "add_buffer_binding")
@extern(rust, "crate::gpu", "add_buffer_binding")
fn add_buffer_binding(buffer: Int) -> Unit = _

@extern(wasm, "gpu", "create_bound_group")
@extern(rust, "crate::gpu", "create_bound_group")
fn create_bound_group(device: Int, pipeline: Int, group_idx: Int) -> Int = _

@extern(wasm, "gpu", "set_bind_group")
@extern(rust, "crate::gpu", "set_bind_group")
fn set_bind_group(pass: Int, index: Int, bind_group: Int) -> Unit = _

// ── Compute pass ──

@extern(wasm, "gpu", "begin_compute_pass")
@extern(rust, "crate::gpu", "begin_compute_pass")
fn begin_compute_pass(encoder: Int) -> Int = _

@extern(wasm, "gpu", "dispatch_workgroups")
@extern(rust, "crate::gpu", "dispatch_workgroups")
fn dispatch_workgroups(pass: Int, x: Int, y: Int, z: Int) -> Unit = _

// ── Buffer data streaming (no raw pointers needed) ──

@extern(wasm, "gpu", "begin_data")
@extern(rust, "crate::gpu", "begin_data")
fn begin_data() -> Unit = _

@extern(wasm, "gpu", "push_f32")
@extern(rust, "crate::gpu", "push_f32")
fn push_f32(value: Float) -> Unit = _

@extern(wasm, "gpu", "push_u32")
@extern(rust, "crate::gpu", "push_u32")
fn push_u32(value: Int) -> Unit = _

@extern(wasm, "gpu", "flush_to_buffer")
@extern(rust, "crate::gpu", "flush_to_buffer")
fn flush_to_buffer(device: Int, buffer: Int) -> Unit = _

/// Write the staged values into the `w` x `h` rectangle of `texture` at
/// (`x`, `y`), one `push_u32` per pixel, row by row: RGBA8 packed as
/// `r | g << 8 | b << 16 | a << 24`. The pointer-free way to fill a texture —
/// a native build has no linear memory for `upload_encoded_image` to read.
@extern(wasm, "gpu", "flush_to_texture")
@extern(rust, "crate::gpu", "flush_to_texture")
fn flush_to_texture(device: Int, texture: Int, x: Int, y: Int, w: Int, h: Int) -> Unit = _

// ── Bind group: texture + sampler entries ──

@extern(wasm, "gpu", "add_texture_binding")
@extern(rust, "crate::gpu", "add_texture_binding")
fn add_texture_binding(texture: Int) -> Unit = _

@extern(wasm, "gpu", "add_sampler_binding")
@extern(rust, "crate::gpu", "add_sampler_binding")
fn add_sampler_binding(sampler: Int) -> Unit = _

// ── Specialized render pipelines ──

@extern(wasm, "gpu", "create_text_pipeline")
@extern(rust, "crate::gpu", "create_text_pipeline")
fn create_text_pipeline(device: Int, shader: Int, format: Int) -> Int = _

@extern(wasm, "gpu", "create_image_pipeline")
@extern(rust, "crate::gpu", "create_image_pipeline")
fn create_image_pipeline(device: Int, shader: Int, format: Int) -> Int = _

// ── Vertex / index buffer rendering ──

@extern(wasm, "gpu", "set_vertex_buffer")
@extern(rust, "crate::gpu", "set_vertex_buffer")
fn set_vertex_buffer(pass: Int, slot: Int, buffer: Int) -> Unit = _

@extern(wasm, "gpu", "set_index_buffer")
@extern(rust, "crate::gpu", "set_index_buffer")
fn set_index_buffer(pass: Int, buffer: Int) -> Unit = _

@extern(wasm, "gpu", "draw_indexed")
@extern(rust, "crate::gpu", "draw_indexed")
fn draw_indexed(pass: Int, index_count: Int) -> Unit = _


// ── Partial buffer write (for scroll_y updates without full rebuild) ──

@extern(wasm, "gpu", "write_f32_at")
@extern(rust, "crate::gpu", "write_f32_at")
fn write_f32_at(device: Int, buffer: Int, byte_offset: Int, value: Float) -> Unit = _

@extern(wasm, "gpu", "write_u32_at")
@extern(rust, "crate::gpu", "write_u32_at")
fn write_u32_at(device: Int, buffer: Int, byte_offset: Int, value: Int) -> Unit = _

// ── Debug ──

@extern(wasm, "gpu", "log_int")
@extern(rust, "crate::gpu", "log_int")
fn log_int(value: Int) -> Unit = _

@extern(wasm, "gpu", "log_str")
@extern(rust, "crate::gpu", "log_str")
fn log_str(ptr: Int, len: Int) -> Unit = _

// ── 3D mesh pass (roadmap phase 3) ───────────────────────────────────────
//
// The 2D path renders a fullscreen quad from a compute-produced pixel buffer:
// no vertex buffers, no depth attachment. Geometry needs its own pipeline and
// its own pass, so these sit alongside rather than replacing anything above.

/// Create (or resize) the depth target the 3D pass renders against. Must be
/// called whenever the drawing buffer changes size — drawing against a stale
/// depth size is a validation error, not a silent mismatch.
@extern(wasm, "gpu", "set_depth_size")
@extern(rust, "crate::gpu", "set_depth_size")
fn set_depth_size(device: Int, w: Int, h: Int) -> Unit = _

/// Pipeline for the standard mesh vertex layout — pos(3) + normal(3) + uv(2),
/// 32-byte stride — depth-tested with `less`, CCW front (glTF's winding). The
/// caller supplies the shader module.
///
/// `cull` selects which faces are discarded: 0 none, 1 back, 2 front. Front
/// culling is what an inverted-hull outline needs — the same geometry drawn
/// expanded along its normals, with only its far side visible.
///
/// `blend`: 0 opaque (alpha ignored), 1 straight alpha over the target.
/// `depth_write`: 0 or 1. Transparent geometry tests depth but must NOT write
/// it, or the nearest transparent surface hides every one behind it.
@extern(wasm, "gpu", "create_mesh_pipeline")
@extern(rust, "crate::gpu", "create_mesh_pipeline")
fn create_mesh_pipeline(device: Int, shader: Int, format: Int, cull: Int,
                        blend: Int, depth_write: Int) -> Int = _

/// Like `begin_render_pass`, with the depth attachment bound. `load` chooses
/// whether the colour target is cleared (0) or preserved (1), so a 3D pass can
/// be composited with the 2D pass in one frame. Depth always clears.
@extern(wasm, "gpu", "begin_render_pass_3d")
@extern(rust, "crate::gpu", "begin_render_pass_3d")
fn begin_render_pass_3d(encoder: Int, r: Float, g: Float, b: Float, a: Float, load: Int) -> Int = _

/// Bind a u16 index buffer — half the bandwidth of the u32 path above, and
/// glTF's common case.
@extern(wasm, "gpu", "set_index_buffer_u16")
@extern(rust, "crate::gpu", "set_index_buffer_u16")
fn set_index_buffer_u16(pass: Int, buffer: Int) -> Unit = _

/// Upload from linear memory at a destination offset, so geometry built in a
/// Bytes arena reaches the GPU without an intermediate copy.
@extern(wasm, "gpu", "write_buffer_at")
@extern(rust, "crate::gpu", "write_buffer_at")
fn write_buffer_at(device: Int, buffer: Int, dst_offset: Int, src_ptr: Int, len: Int) -> Unit = _

// ── Textures, samplers, ranged draws ─────────────────────────────────────
//
// Creating a texture and filling it are SEPARATE because a decode is async in
// the browser while a wasm call is not. The texture is created at its final
// size up front — the caller reads that from the image header, which is file
// parsing, not a GPU concern — so bind groups made against it stay valid when
// the pixels arrive later. Swapping the texture object after a decode would
// silently orphan every bind group already built from it.

/// An empty RGBA8 texture, ready to be bound and filled.
@extern(wasm, "gpu", "create_texture")
@extern(rust, "crate::gpu", "create_texture")
fn create_texture(device: Int, w: Int, h: Int) -> Int = _

/// Decode an encoded image (PNG/JPEG) from linear memory into `texture`. The
/// decode completes asynchronously; the texture reads as transparent until it
/// does, never as garbage.
@extern(wasm, "gpu", "upload_encoded_image")
@extern(rust, "crate::gpu", "upload_encoded_image")
fn upload_encoded_image(device: Int, texture: Int, ptr: Int, len: Int) -> Unit = _

/// `filter`: 0 nearest, 1 linear. `wrap`: 0 clamp-to-edge, 1 repeat.
@extern(wasm, "gpu", "create_sampler")
@extern(rust, "crate::gpu", "create_sampler")
fn create_sampler(device: Int, filter: Int, wrap: Int) -> Int = _

/// Draw a RANGE of the bound index buffer. One draw per material needs this —
/// `draw_indexed` can only start at zero.
@extern(wasm, "gpu", "draw_indexed_from")
@extern(rust, "crate::gpu", "draw_indexed_from")
fn draw_indexed_from(pass: Int, first_index: Int, index_count: Int) -> Unit = _
