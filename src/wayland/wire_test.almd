// The Wayland wire format: what libwayland puts on the socket for the same
// requests, byte for byte, and events split back out of a stream.

import self.wayland.wire as wire

test "a string argument: length with the NUL, bytes, padded to a word" {
  // "wl_shm": 7 bytes with its NUL, two words of bytes.
  assert_eq(wire.string("wl_shm"), [7, 0x735F6C77, 0x6D68])
  // Exactly 3 characters + NUL fill one word; the empty string is its NUL.
  assert_eq(wire.string("abc"), [4, 0x00636261])
  assert_eq(wire.string(""), [1, 0])
}

test "a request: object, size and opcode, then the words" {
  let b = wire.request(3, 2, [10, 20])
  assert_eq(bytes.len(b), 16)
  assert_eq(bytes.read_u32_le(b, 0), 3)
  assert_eq(bytes.read_u32_le(b, 4), 16 * 65536 + 2)
  assert_eq(bytes.read_u32_le(b, 12), 20)
  // A negative int argument is its two's-complement word.
  assert_eq(bytes.read_u32_le(wire.request(1, 0, [wire.int32(0 - 1)]), 8), 0xFFFFFFFF)
}

test "24.8 fixed point" {
  assert_eq(wire.fixed(1.5), 384)
  assert_eq(wire.fixed(0.0 - 1.0), 0xFFFFFF00)
  let b = wire.request(1, 0, [wire.fixed(0.0 - 2.25)])
  assert_eq(wire.fixed_at(bytes.slice(b, 8, 12), 0), 0.0 - 2.25)
}

test "events split out of a stream, a partial one kept" {
  let a = wire.request(2, 0, [7] + wire.string("wl_seat") + [5])
  let b = wire.request(9, 1, [42])
  let stream = bytes.concat(bytes.concat(a, b), bytes.slice(a, 0, 6))
  let split = wire.split(stream)
  assert_eq(list.len(split.0), 2)
  assert_eq(split.0[0].obj, 2)
  assert_eq(wire.uint_at(split.0[0].args, 0), 7)
  let name = wire.string_at(split.0[0].args, 4)
  assert_eq(name.0, "wl_seat")
  assert_eq(wire.uint_at(split.0[0].args, name.1), 5)
  assert_eq(split.0[1].op, 1)
  assert_eq(wire.uint_at(split.0[1].args, 0), 42)
  assert_eq(bytes.len(split.1), 6)
}

test "an array argument" {
  let b = wire.request(1, 0, [5, 0x04030201, 0x05])
  let arr = wire.array_at(bytes.slice(b, 8, bytes.len(b)), 0)
  assert_eq(bytes.to_list(arr.0), [1, 2, 3, 4, 5])
  assert_eq(arr.1, 12)
}
