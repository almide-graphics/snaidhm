test "face count and an absent face" {
  assert_eq(sfnt.face_count(data()), 4)
  assert_eq(sfnt.load(data(), 4) |> result.is_err, true)
}

test "not a font" {
  assert_eq(sfnt.load(bytes.new(4), 0) |> result.is_err, true)
}
