// Phase 0: Triangle — Almide source that compiles to WGSL
//
// Compile: almide main.almd --target wgsl
// Output should match triangle.wgsl (hand-written reference)

type VertexOutput = {
  @builtin(position) pos: Float,
  @location(0) color: Float,
}

@gpu(vertex)
fn vs_main(@builtin(vertex_index) idx: UInt32) -> VertexOutput = {
  let positions_x = [0.0, -0.5, 0.5]
  let positions_y = [0.5, -0.5, -0.5]
  let colors = [1.0, 0.0, 0.0]

  VertexOutput {
    pos: positions_x[idx],
    color: colors[idx],
  }
}

@gpu(fragment)
@location(0)
fn fs_main(@location(0) color: Float) -> Float = {
  color
}
